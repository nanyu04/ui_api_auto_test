# ============================================================
#  RuoYi-Vue 接口自动化 —— 环境变量模板
#  复制为 .env 后按实际环境修改（.env 已在 .gitignore 中）
# ============================================================

# 环境标识：dev / test / staging / prod
ENV=dev

# 被测后端地址（application.yml: server.port=8081, context-path=/）
BASE_URL=http://localhost:8081
# 走前端 dev-server 代理时设为 /dev-api，后端直连保持为空
API_PREFIX=

# 测试账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 普通账号（角色 common），用于权限/越权用例；不填则自动跳过
COMMON_USERNAME=
COMMON_PASSWORD=

# 验证码：测试库建议关闭 sys.account.captchaEnabled
CAPTCHA_ENABLED=false

# 超时与日志
REQUEST_TIMEOUT=15
LOG_LEVEL=INFO
LOG_FORMAT=standard

# 数据库校验（可选，DB_ENABLED=true 才会生效）
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ry-vue
